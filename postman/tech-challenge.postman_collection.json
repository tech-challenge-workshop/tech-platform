              }
            ],
            "url": {
              "raw": "{{baseUrl}}/repair-services",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "repair-services"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Troca de pastilhas\",\n  \"priceCents\": 25000\n}"
