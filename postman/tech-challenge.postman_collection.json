{
  "info": {
    "name": "Tech Challenge — Oficina",
    "description": "Every request goes through Kong. Nothing talks to a service directly.\n\nRun the folders in order: **1 Auth** issues the tokens the rest need, **2 Catálogo** seeds data and stores the ids, **3 Saga** runs a work order end to end, **4 Segurança** shows what the gateway and the guards reject.\n\nIds and tokens are captured automatically into collection variables — you should not have to copy anything by hand.\n\nSwitch `baseUrl` to `http://localhost:8000` to run against the local compose.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://a7b77c47b9484427e9a5cc0ffbc456f6-c123291b007cdb68.elb.us-east-1.amazonaws.com",
      "type": "string",
      "description": "Kong's load balancer. It changes every time the cluster is recreated: kubectl get svc -n kong kong-gateway-proxy -o jsonpath='{.status.loadBalancer.ingress[0].hostname}'. Use http://localhost:8000 for the local compose."
    },
    {
      "key": "adminApiKey",
      "value": "",
      "type": "string",
      "description": "Not committed. Read it from k8s/.secrets.env after secrets-from-tofu.sh has run:  grep '^ADMIN_API_KEY=' k8s/.secrets.env"
    },
    {
      "key": "document",
      "value": "111.444.777-35",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "vehicleId",
      "value": "",
      "type": "string"
    },
    {
      "key": "serviceId",
      "value": "",
      "type": "string"
    },
    {
      "key": "partId",
      "value": "",
      "type": "string"
    },
    {
      "key": "workOrderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 · Autenticação",
      "description": "Both routes are public — they are how a caller obtains a credential.",
      "item": [
        {
          "name": "Admin — obter token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{adminApiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/admin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "admin"
              ]
            },
            "description": "Constant-time comparison against ADMIN_API_KEY. Wrong key returns 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) pm.collectionVariables.set('adminToken', body.token);",
                  "pm.test('status is ok', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cliente — obter token por CPF",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "description": "auth-service validates the check digits, then calls /customers/lookup before issuing a token with role=customer.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document\": \"{{document}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) pm.collectionVariables.set('customerToken', body.token);",
                  "pm.test('status is ok', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 · Catálogo (admin)",
      "description": "Seeds the data a work order needs. Ids are stored automatically.",
      "item": [
        {
          "name": "Criar peça",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/parts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "parts"
              ]
            },
            "description": "Lives in MongoDB Atlas, owned by execution-service.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pastilha de freio\",\n  \"priceCents\": 5000,\n  \"initialQuantity\": 100\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('partId', body.id);",
                  "pm.test('status is ok', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar serviço",
          "request": {
